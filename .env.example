# Copy to .env for local runs (never commit .env). In production these live in
# GitHub: Settings → Secrets and variables → Actions.

# Free Gemini API key from https://aistudio.google.com/apikey (no credit card)  [secret]
GEMINI_API_KEY=

# Optional free fallback from https://console.groq.com/keys                   [secret]
GROQ_API_KEY=

# Family WhatsApp group JID, e.g. 120363012345678901@g.us                      [variable]
# Find it with the "WhatsApp setup" workflow (action: list-groups).
FAMILY_WHATSAPP_GROUP_ID=

# true = never send, whatever the command says (safety switch)                 [variable]
MORNING_BRIEF_DRY_RUN=false

# true = let the 7:30 AM schedule send (the only switch for the automation)    [variable]
MORNING_BRIEF_ENABLED=false
